# ==========================================
# 自作数学DSL 総合ベンチマーク＆テストコード
# ==========================================

# 1. 関数定義とべき乗（^）のテスト
f(x) = x^2 + 2 * x + 1

# 2. 変数の初期化
success = 0
err_code = 0

total = 0
a = 10
x = 5

# 3. 複合代入とインクリメント・デクリメントのテスト
a += 5  # 15
a -= 3  # 12
a *= 2  # 24
a /= 4  # 6
a++     # 7
a--     # 6

# 4. forループと if / else の複合テスト
for (i = 0; i < 10; i++) {
	# 奇数か偶数かで分岐（2で割って戻して元の値になるかで判定）
	half = i / 2
	double = half * 2
	
	if (i == double) {
		# 偶数の場合: 合計に加算
		total += i
	} else {
		# 奇数の場合: 何もしない
		total += 0
	}
}
# 0+2+4+6+8 = 20 になるべき

# 5. 最終判定（すべての計算結果が仕様通りかチェック）
# 期待値: a == 6, total == 20, f(3) == 16 (3^2 + 2*3 + 1 = 9 + 6 + 1)
if (a == 6) {
	if (total == 20) {
		if (f(3) == 16) {
			success = 1
		} else {
			err_code = 3 # 関数またはべき乗のエラー
		}
	} else {
		err_code = 2 # forループまたはif分岐のエラー
	}
} else {
	err_code = 1 # 複合代入またはインクリメントのエラー
}

# 6. 最終出力
if (success == 1) {
	@ans = 1      # 完璧に合格なら 1 を出力
} else {
	@ans = err_code # 不合格ならエラー原因コードを出力
}
