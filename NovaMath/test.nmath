# --- 変数の初期化 ---
grand_total = 0

# --- 2から300までのメインループ ---
for (i = 2; i <= 300; i++) {
    
    is_prime = 1
    root_i = sqrt(i)
    mod_one = root_i % 1
    limit = root_i - mod_one  # ここまでは同じ
    
    # ★【バグ回避】forの条件式に変数を使わず、固定値「17」まで強制的に回す！
    # これなら、forの条件判定でのレジスタ破壊は絶対に起きません。
    for (j = 2; j <= 17; j++) {
        
        # j が本来の上限（limit）以下のときだけ、素数判定を行う
        if (j <= limit) {
            mod_j = i % j
            if (mod_j == 0) {
                is_prime = 0
            } else {
                grand_total += 0
            }
        } else {
            # limit を超えたら何もしない（実質的なbreakの代わり）
            grand_total += 0
        }
    }
    
    # 条件に応じた加減算
    if (is_prime == 1) {
        grand_total += i ^ 2
    } else {
        mod_limit = i % limit
        
        if (mod_limit == 0) {
            diff = i - 100
            grand_total += abs(diff)
        } else {
            grand_total -= i
        }
    }
}

# --- 最終出力 ---
@ans = grand_total
